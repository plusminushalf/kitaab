{
  "name": "kitaab",
  "productName": "Kitaab",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "Kitaab: a small macOS client for a Hermes Agent server",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs && env -u ELECTRON_RUN_AS_NODE ELECTRON_EXEC_PATH=\"node_modules/.kitab-electron/Kitaab Dev.app/Contents/MacOS/Electron\" electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && node scripts/package-mac.mjs",
    "install-app": "electron-vite build && node scripts/package-mac.mjs --install",
    "start": "node scripts/dev-electron.mjs && env -u ELECTRON_RUN_AS_NODE ELECTRON_EXEC_PATH=\"node_modules/.kitab-electron/Kitaab Dev.app/Contents/MacOS/Electron\" electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dmg": "electron-vite build && node scripts/package-mac.mjs && node scripts/make-dmg.mjs"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "1.67.0",
    "posthog-js": "^1.447.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
