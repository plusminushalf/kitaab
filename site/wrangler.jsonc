  // kitaab.plusminushalf.com: the static site in this folder, served by Cloudflare
  // the same way as pitwall.plusminushalf.com. Deploy with: bunx wrangler@4 deploy
  "name": "kitaab-site",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "." },
  "routes": [{ "pattern": "kitaab.plusminushalf.com", "custom_domain": true }]
}
